PORT=4000
API_PREFIX=api
APP_NAME=Customer Panel
CORS_ORIGIN=http://localhost:3000

# Postgres — read by docker-compose.yml to configure the container
POSTGRES_USER=customer_panel
POSTGRES_PASSWORD=customer_panel
POSTGRES_DB=customer_panel
POSTGRES_PORT=5432

# Read by the app (Prisma driver adapter) and by the Prisma CLI (prisma.config.ts)
DATABASE_URL="postgresql://customer_panel:customer_panel@localhost:5432/customer_panel?schema=public"

# JWT — change JWT_SECRET for anything beyond local development
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN_SECONDS=3600
